{
  "name": "opencode-senses",
  "version": "0.1.0",
  "description": "The vision plugin for OpenCode that truly understands images. Inspect, read, and reason about any screenshot or picture with deeper understanding than any other plugin — fully local, private, and free.",
  "type": "module",
  "author": "opencode-senses",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsmeadarsh2008/opencode-senses.git"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run build",
    "publish:npm": "npm publish"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.17.15",
    "@opencode-ai/sdk": "1.17.15",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "main": "./dist/plugin.js",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "opencode",
    "plugin",
    "multimodal",
    "vision",
    "moondream",
    "screenshot",
    "ocr"
  ],
  "engines": {
    "bun": ">=1.0.0"
  }
}